# Пример окружения бота поддержки. Настоящие значения — только в .env (локально, в .gitignore)
# или в /etc/ruai-support-bot.env на сервере (root:root, chmod 600). В репозиторий не коммитить.

# Токен от @BotFather
BOT_TOKEN=
# id супергруппы поддержки с включёнными темами, вида -100…
SUPPORT_CHAT_ID=

# Каталог для SQLite. На сервере его задаёт systemd (/var/lib/ruai-support-bot), локально — ./data
DATA_DIR=./data

# Необязательно:
# RATE_LIMIT_PER_MINUTE=20     # сообщений от одного пользователя в минуту
# MAX_TEXT_LENGTH=3000         # максимальная длина текста от пользователя
# NEW_TOPICS_PER_HOUR=60       # новых тем в час на всех (защита от наплыва новых аккаунтов)
# TELEGRAM_API_BASE=https://api.telegram.org
