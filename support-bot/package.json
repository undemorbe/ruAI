{
  "name": "ruai-support-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Telegram-бот поддержки ru-chatgpt.com: обращения пользователей уходят в темы супергруппы команды.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
