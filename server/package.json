{
  "name": "ruai-admin-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API админки ruAI: вход по паролю и TOTP, сессии, журнал, отчёты. Только за nginx на 127.0.0.1.",
  "scripts": {
